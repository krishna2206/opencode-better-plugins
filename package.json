{
  "name": "opencode-better-plugins",
  "version": "0.1.0",
  "description": "Better plugin manager for OpenCode V2: interactive TUI selector to enable and disable plugins via JSONC configuration.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "default": "./dist/tui.js"
    }
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc && node scripts/prepare-tui-dist.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-typescript": "^7.27.1",
    "@opencode/plugin": "2.2.5",
    "@opentui/core": "0.8.1",
    "@opentui/solid": "0.8.1",
    "@types/node": "^26.1.2",
    "babel-preset-solid": "^1.9.12",
    "solid-js": "1.9.15",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.2.0",
    "@opentui/core": ">=0.8.1",
    "@opentui/solid": ">=0.8.1",
    "solid-js": "^1.9.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT"
}
